# OGO Manager Pro - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Supabase Service Role Key (for admin operations)
# VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Application Configuration
VITE_APP_NAME=OGO Manager Pro
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG_LOGS=false

# Database Configuration (if using direct connection)
# DATABASE_URL=postgresql://username:password@host:port/database

# Email Configuration (for notifications)
# VITE_SMTP_HOST=smtp.gmail.com
# VITE_SMTP_PORT=587
# VITE_SMTP_USER=your_email@gmail.com
# VITE_SMTP_PASS=your_app_password

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760  # 10MB in bytes
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Security Configuration
VITE_SESSION_TIMEOUT=3600000  # 1 hour in milliseconds
VITE_MAX_LOGIN_ATTEMPTS=5

# Analytics Configuration (optional)
# VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
# VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Error Reporting (optional)
# VITE_SENTRY_DSN=your_sentry_dsn
# VITE_BUGSNAG_API_KEY=your_bugsnag_key

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_RECEIPTS=true
VITE_ENABLE_CALENDAR=true
VITE_ENABLE_REPORTS=true

# API Configuration
VITE_API_BASE_URL=https://api.ogo.technology
VITE_API_TIMEOUT=30000  # 30 seconds

# Cache Configuration
VITE_CACHE_DURATION=300000  # 5 minutes in milliseconds
VITE_ENABLE_OFFLINE_MODE=false

# Notification Configuration
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=false

# Development Tools
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_SOURCE_MAPS=true
